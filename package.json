{
  "name": "video-toolkit-rizumiya",
  "version": "1.0.0",
  "description": "Video processing toolkit with AI-powered features and Repliz integration",
  "main": "index.js",
  "type": "commonjs",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --targets node18-win-x64 --output dist/VideoToolkit-Rizumiya.exe --compress GZip",
    "build:all": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/VideoToolkit-Rizumiya --compress GZip"
  },
  "keywords": [
    "video",
    "toolkit",
    "ffmpeg",
    "ai",
    "repliz",
    "automation"
  ],
  "author": "@rizumiya",
  "license": "ISC",
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.13.5",
    "chalk": "^4.1.2",
    "dotenv": "^17.2.4",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "inquirer": "^8.2.4",
    "open": "^8.4.2",
    "socket.io": "^4.7.4",
    "tiktok-tts-node": "^1.0.6"
  },
  "pkg": {
    "assets": [
      "src/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist",
    "scripts": [
      "src/**/*.js"
    ]
  }
}
