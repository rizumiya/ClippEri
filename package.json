{
  "name": "clipperi",
  "version": "1.0.0",
  "description": "ClippEri — AI-powered video clipper, editorial subtitle studio, and video workflow suite",
  "main": "index.js",
  "type": "commonjs",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "gui": "node src/server.js",
    "build": "pkg . --targets node18-win-x64 --output dist/ClippEri.exe --compress GZip",
    "build:all": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/ClippEri --compress GZip"
  },
  "keywords": [
    "clipperi",
    "video-clipper",
    "subtitle",
    "whisper",
    "ffmpeg",
    "ai",
    "automation"
  ],
  "author": "@rizumiya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rizumiya/ClippEri.git"
  },
  "homepage": "https://github.com/rizumiya/ClippEri#readme",
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.13.5",
    "chalk": "^4.1.2",
    "dotenv": "^17.2.4",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "inquirer": "^8.2.4",
    "msedge-tts": "^2.1.1",
    "open": "^8.4.2",
    "socket.io": "^4.7.4",
    "tiktok-tts-node": "^1.0.6"
  },
  "pkg": {
    "assets": [
      "src/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist",
    "scripts": [
      "src/**/*.js"
    ]
  }
}
